*apple-client-secret*

# macOS
.expo-shared/

# Env
# Glob, not two literals: `.env` and `.env.local` alone would have let a
# `.env.production` or `.env.deploy` be committed, which is exactly where
# deployment and registrar credentials tend to end up.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# Xcode / iOS
ios/Pods/
ios/build/
*.xcworkspace/xcuserdata/

# Android
android/.gradle/
android/app/build/

# Local generation/QC tooling (not part of the app bundle)
scripts/_tmp_*

# Supabase CLI local link/cache metadata
supabase/.temp/

# Python bytecode from the film pipeline
__pycache__/
*.pyc
